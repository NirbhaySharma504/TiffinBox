# Copy to .env and fill in. docker-compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=tiffinbox
POSTGRES_PASSWORD=tiffinbox

# --- JWT (must be the same for user-service and api-gateway; >=32 bytes) ---
JWT_SECRET=TiffinBoxSuperSecretKeyForJwtSigning_ChangeMe_AtLeast32Bytes!!

# --- Seeded owner/admin account (created on first boot if no OWNER exists) ---
OWNER_NAME=Tiffin Owner
OWNER_EMAIL=owner@tiffinbox.com
OWNER_PASSWORD=owner123

# --- Email (notification-service). Leave disabled to log emails instead of sending. ---
NOTIFICATION_MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Frontend origin allowed by the gateway CORS filter ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
